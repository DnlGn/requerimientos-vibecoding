# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Opcional pero recomendado: sin key, Google limita mucho las consultas a PageSpeed.
# https://developers.google.com/speed/docs/insights/v5/get-started
VITE_PSI_API_KEY=

# Opcional: dominio público donde se despliega la app (para los QR).
# Si se deja vacío se usa el dominio actual del navegador.
VITE_PUBLIC_BASE_URL=
